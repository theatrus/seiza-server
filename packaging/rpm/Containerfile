ARG BASE=registry.fedoraproject.org/fedora:44
FROM ${BASE}

ARG TARGET

RUN dnf install -y \
        bash \
        ca-certificates \
        cmake \
        findutils \
        gcc \
        gcc-c++ \
        git \
        gzip \
        make \
        openssl-devel \
        perl \
        pkgconf-pkg-config \
        rpm-build \
        tar \
        which \
    && dnf clean all

# Vite 8 requires a current Node release. AL2023 provides namespaced Node.js
# packages, while Fedora exposes the unversioned current package.
RUN if [ "${TARGET}" = "al2023" ]; then \
        dnf install -y nodejs22 nodejs22-npm && \
        alternatives --set node /usr/bin/node-22 && \
        ln -s /usr/bin/npm-22 /usr/local/bin/npm; \
    else \
        dnf install -y nodejs npm; \
    fi \
    && dnf clean all

# AL2023's system Rust can lag the edition/toolchain required by the server.
# Preinstall the repository's exact toolchain in a world-readable location so
# the unprivileged RPM build does not need to mutate the root-owned rustup home.
ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:${PATH}
COPY rust-toolchain.toml /tmp/rust-toolchain.toml
RUN mkdir -p "${RUSTUP_HOME}" "${CARGO_HOME}" \
    && rust_version="$(sed -n 's/^channel = "\(.*\)"$/\1/p' /tmp/rust-toolchain.toml)" \
    && test -n "${rust_version}" \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain none \
    && rustup toolchain install "${rust_version}" --profile minimal \
        --component clippy --component rustfmt \
    && rustup default "${rust_version}" \
    && rm /tmp/rust-toolchain.toml \
    && chmod -R a+rX "${RUSTUP_HOME}" "${CARGO_HOME}"
